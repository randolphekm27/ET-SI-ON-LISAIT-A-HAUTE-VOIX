# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ORGANIZER_ACCESS_CODE: Access code for the UCAEP organizer CMS (/gestion)
ORGANIZER_ACCESS_CODE="UCAEP-LOKOSSA-2026"

# GOOGLE_APPS_SCRIPT_URL: Optional Web App endpoint from Google Apps Script
# linked to your Google Form / Google Sheet for candidate registrations.
GOOGLE_APPS_SCRIPT_URL=""

# GOOGLE_FORM_ACTION_URL: Optional direct Google Form formResponse endpoint
GOOGLE_FORM_ACTION_URL=""
